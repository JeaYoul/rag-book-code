; ┌──────────────────────────────────────────────────────────────────────┐
; │  이렇게 쓰지 마라 — 20장의 사고를 낸 파일 (실제 운영 파일에서 옮김)      │
; └──────────────────────────────────────────────────────────────────────┘
;
; 무슨 일이 있었나
;   이 서비스를 멈출 때마다 곁에 있던 다른 앱이 같이 죽었다. 열두 번.
;   그 앱은 자기 규칙(Restart=always)대로 10초 뒤 되살아났고, 이 서비스의
;   재시작 횟수는 0이었다. 그래서 원인을 찾는 데 오래 걸렸다.
;
; 무엇이 잘못됐나 — 세 줄에 다 있다
;   1) Type=forking      스크립트가 앱 여럿을 낳고 물러난다 → systemd 는 자기가 뭘 띄웠는지 모른다
;   2) ExecStart=…sh     그래서 부모를 잃은 프로세스가 포트를 쥔 채 남는다 (고아)
;   3) ExecStop=pkill…   그것을 치우려고 "이름으로" 죽인다 → 같은 이름을 쓰는 남의 앱까지 죽는다
;
; 고친 것: rag-home.service 를 보라. Type=simple · 프로그램 직접 실행 · ExecStop 없음.
; 앱이 셋이면 파일도 셋. 파일이 느는 것을 아까워하지 마라.

[Unit]
Description=Streamlit apps (8501/8502/8503)
After=network.target docker.service postgresql.service mongod.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=forking
User=npk_star
WorkingDirectory=/home/npk_star/ai-rag-platform/src
ExecStart=/bin/bash /home/npk_star/ai-rag-platform/start_all.sh
ExecStop=/usr/bin/pkill -u npk_star -f "streamlit run"
RemainAfterExit=yes
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
