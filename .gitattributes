# 리눅스에서 도는 파일은 줄바꿈을 LF로 못 박는다.
# CRLF로 내려가면 셸 스크립트는 첫 줄부터 깨진다 ("bad interpreter: /usr/bin/env bash^M")
*.sh            text eol=lf
*.service       text eol=lf
*.py            text eol=lf
*.sql           text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
Dockerfile      text eol=lf
*.example       text eol=lf
ch20-ops/logrotate/guardian text eol=lf
