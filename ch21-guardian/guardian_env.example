# ~/.guardian_env 로 복사해 쓴다 (21장)
#   cp guardian_env.example ~/.guardian_env && chmod 600 ~/.guardian_env
#
# 토큰은 코드에 넣지 않는다. 코드를 남에게 보여 줘도 토큰은 따라가지 않게.
# 이 파일이 없으면 파수꾼들은 자동으로 연습 모드(화면 출력)로 돈다.

# 텔레그램에서 봇을 만들면 받는 토큰
TELEGRAM_TOKEN=1234567890:여기에_봇_토큰

# 알림을 받을 대화방 번호 (봇에게 아무 말이나 보낸 뒤
#   curl "https://api.telegram.org/bot<토큰>/getUpdates" 로 확인)
TELEGRAM_CHAT_ID=123456789
